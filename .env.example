# ═══════════════════════════════════════════════════════════
#  VeriLens — Environment Variables (Mobile App)
# ═══════════════════════════════════════════════════════════
#
# Copy to .env and fill in. Read by constants/config.ts.
# Expo inlines EXPO_PUBLIC_* at build time, so the prefix is required.
#
# NEVER put a private key in here. Nothing secret belongs in an
# EXPO_PUBLIC_* variable — it ships inside the app bundle.
# ═══════════════════════════════════════════════════════════

# ──── Forensics service (service/) ────
# The detector. Run locally with:
#   cd service && uvicorn main:app --reload --host 0.0.0.0 --port 8000
# On a physical device use your machine's LAN IP, not localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# ──── Supabase (free tier: supabase.com) ────
# Optional. Without it, cases stay in local SQLite only.
# 1. https://supabase.com -> New Project
# 2. Settings -> API -> copy URL and anon key
# 3. Run supabase-setup.sql in the SQL editor
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ═══════════════════════════════════════════════════════════
#  Not env-configurable (see constants/config.ts)
# ═══════════════════════════════════════════════════════════
#
#  CHAIN_RPC / CHAIN_ID / CHAIN_EXPLORER / CHAIN_FAUCET
#    Ethereum Sepolia, chain 11155111. Hardcoded — public endpoints.
#
#  CONTRACT_ADDRESS
#    Zero address. Anchoring uses a data-only self-transfer with the
#    ABI-encoded payload in tx.data, so no contract deploy is needed.
#
#  WALLET_PRIVATE_KEY
#    Empty. A per-device wallet is generated in expo-secure-store and
#    funded from the in-app faucet button.
